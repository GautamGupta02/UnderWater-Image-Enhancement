# 🔹 Conv Block
class ConvBlock(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.block = nn.Sequential(
            nn.Conv2d(in_ch, out_ch, 3, padding=1),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True),

            nn.Conv2d(out_ch, out_ch, 3, padding=1),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True)
        )

    def forward(self, x):
        return self.block(x)


# 🔹 Attention Block (FIXED)
class AttentionBlock(nn.Module):
    def __init__(self, g_ch, x_ch, inter_ch):
        super().__init__()

        self.W_g = nn.Sequential(
            nn.Conv2d(g_ch, inter_ch, 1),
            nn.BatchNorm2d(inter_ch)
        )

        self.W_x = nn.Sequential(
            nn.Conv2d(x_ch, inter_ch, 1),
            nn.BatchNorm2d(inter_ch)
        )

        self.psi = nn.Sequential(
            nn.Conv2d(inter_ch, 1, 1),
            nn.BatchNorm2d(1),
            nn.Sigmoid()
        )

        self.relu = nn.ReLU(inplace=True)

    def forward(self, g, x):
        g1 = self.W_g(g)
        x1 = self.W_x(x)

        # 
        g1 = F.interpolate(g1, size=x1.shape[2:], mode='bilinear', align_corners=False)

        psi = self.relu(g1 + x1)
        psi = self.psi(psi)

        return x * psi


# 🔹 Up Block
class UpBlock(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.up = nn.ConvTranspose2d(in_ch, out_ch, 2, stride=2)
        self.conv = ConvBlock(in_ch, out_ch)

    def forward(self, x, skip):
        x = self.up(x)
        x = torch.cat([skip, x], dim=1)
        return self.conv(x)


# 🔹 Attention ResUNet
class AttentionResUNet(nn.Module):
    def __init__(self):
        super().__init__()

        self.pool = nn.MaxPool2d(2)

        # Encoder
        self.e1 = ConvBlock(3, 64)
        self.e2 = ConvBlock(64, 128)
        self.e3 = ConvBlock(128, 256)
        self.e4 = ConvBlock(256, 512)

        # Bottleneck
        self.b = ConvBlock(512, 1024)

        # Attention Gates
        self.a4 = AttentionBlock(1024, 512, 256)
        self.a3 = AttentionBlock(512, 256, 128)
        self.a2 = AttentionBlock(256, 128, 64)
        self.a1 = AttentionBlock(128, 64, 32)

        # Decoder
        self.d4 = UpBlock(1024, 512)
        self.d3 = UpBlock(512, 256)
        self.d2 = UpBlock(256, 128)
        self.d1 = UpBlock(128, 64)

        # Output
        self.out = nn.Conv2d(64, 3, 1)

    def forward(self, x):
        # Encoder
        e1 = self.e1(x)                     # 256x256
        e2 = self.e2(self.pool(e1))         # 128x128
        e3 = self.e3(self.pool(e2))         # 64x64
        e4 = self.e4(self.pool(e3))         # 32x32

        # Bottleneck
        b = self.b(self.pool(e4))           # 16x16

        # Decoder with Attention
        d4 = self.d4(b, self.a4(b, e4))     # 32x32
        d3 = self.d3(d4, self.a3(d4, e3))   # 64x64
        d2 = self.d2(d3, self.a2(d3, e2))   # 128x128
        d1 = self.d1(d2, self.a1(d2, e1))   # 256x256

        return torch.sigmoid(self.out(d1))
