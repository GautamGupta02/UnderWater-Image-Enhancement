class UIEBDataset(Dataset):
    def __init__(self, raw_dir, gt_dir):
        self.raw_dir = raw_dir
        self.gt_dir = gt_dir

        raw_files = set(os.listdir(self.raw_dir))
        gt_files = set(os.listdir(self.gt_dir))

        self.image_names = sorted([
            f for f in raw_files & gt_files
            if f.endswith(('.jpg', '.png'))
        ])

        self.transform = A.Compose([
            A.Resize(256, 256),
            A.HorizontalFlip(p=0.5),
        ])

    def __len__(self):
        return len(self.image_names)

    def __getitem__(self, idx):
        name = self.image_names[idx]

        raw = cv2.imread(os.path.join(self.raw_dir, name))
        gt = cv2.imread(os.path.join(self.gt_dir, name))

        if raw is None or gt is None:
            raise ValueError(f"Error loading image: {name}")

        raw = cv2.cvtColor(raw, cv2.COLOR_BGR2RGB)
        gt = cv2.cvtColor(gt, cv2.COLOR_BGR2RGB)

        augmented = self.transform(image=raw, mask=gt)
        raw = augmented["image"]
        gt = augmented["mask"]

        raw = torch.tensor(raw).permute(2,0,1).float() / 255.0
        gt = torch.tensor(gt).permute(2,0,1).float() / 255.0

        return raw, gt

